# Copy to .env to change the defaults of `docker compose up`.

# Where the web app is opened:  http://localhost:8080
WEB_PORT=8080

# The backend the page reaches under /api.
#   local backend_mapato stack (its web container listens on 8000):  http://host.docker.internal:8000
#   another container in the same docker network:                    http://web:80
#   the live server:                                                 https://3inone.nexoryatech.com
API_UPSTREAM=http://host.docker.internal:8000

# Only when API_UPSTREAM is another site: the domain name to send with the request (otherwise leave it out).
#API_HOST=3inone.nexoryatech.com

# "/" when the app has its own address; "/app/" when it lives under the same domain as the API (see README).
BASE_HREF=/
