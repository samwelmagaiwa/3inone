APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# L5-Swagger (API documentation at /api/documentation)
L5_SWAGGER_CONST_HOST=https://depot.magrethschools.sc.tz/api
L5_SWAGGER_GENERATE_ALWAYS=false

# Text messages (Kilakona). Password reset codes and the registration phone check are
# texted through this. Leave SMS_ENABLED=false (or the key empty) and messages are only
# written to the log; in production the app then refuses to issue codes.
# Put the real values in the server's .env -- never commit them.
SMS_DRIVER=log
SMS_ENABLED=false
SMS_API_URL=https://messaging.kilakona.co.tz/api/v1/vendor/message/send
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_SENDER_ID=
SMS_COUNTRY_CODE=255
# Numbers (comma separated) texted when a business applies to register, on top of every active
# super admin who has a phone number saved on their account. Leave empty to text only the super admins.
SUPER_ADMIN_NOTIFY_PHONES=

# Plans and paid-until dates (see config/billing.php). Every business has a plan and a valid_until
# date, but NOTHING is locked until BILLING_ENFORCE=true: then a business whose valid_until plus the
# grace period has passed is told to renew (HTTP 402, never signed out). Decide how you charge first.
BILLING_ENFORCE=false
BILLING_TRIAL_DAYS=30
BILLING_GRACE_DAYS=7

# Optional: turns on the AI advice (Where to improve) in the shop's monthly report. Leave empty to use plain rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
